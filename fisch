    Button.TextSize = 11
    Button.AutoButtonColor = false
    Button.Parent = parent

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Button

    Button.MouseEnter:Connect(function() Button.BackgroundColor3 = COLORS.PANEL_HOVER end)
    Button.MouseLeave:Connect(function() Button.BackgroundColor3 = COLORS.PANEL end)
    return Button
end

