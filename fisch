local function CreateCategory(name)
    local Frame = Instance.new("ScrollingFrame")
    Frame.Name = name .. "Category"
    Frame.Size = UDim2.new(1, 0, 1, 0)
    Frame.BackgroundTransparency = 1
    Frame.BorderSizePixel = 0
    Frame.ScrollBarThickness = 3
    Frame.ScrollBarImageColor3 = COLORS.CYAN
    Frame.CanvasSize = UDim2.new(0, 0, 0, 0)
    Frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Frame.Visible = false
    Frame.Parent = ContentHolder

    local Padding = Instance.new("UIPadding")
    Padding.PaddingTop = UDim.new(0, 4)
    Padding.PaddingBottom = UDim.new(0, 12)
    Padding.PaddingLeft = UDim.new(0, 2)
    Padding.PaddingRight = UDim.new(0, 6)
    Padding.Parent = Frame

    local Layout = Instance.new("UIListLayout")
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.Padding = UDim.new(0, 8)
    Layout.Parent = Frame

    Categories[name] = Frame
    return Frame
end

local function ShowCategory(name)
    for categoryName, frame in pairs(Categories) do
        frame.Visible = (categoryName == name)
    end
    for buttonName, button in pairs(CategoryButtons) do
        if buttonName == name then
            button.BackgroundColor3 = COLORS.CYAN
            button.TextColor3 = COLORS.DARK
        else
            button.BackgroundColor3 = COLORS.PANEL
            button.TextColor3 = COLORS.TEXT
        end
    end
end

local function CreateCategoryButton(name)
    local Button = Instance.new("TextButton")
    Button.Name = name .. "Button"
    Button.Size = UDim2.new(0, 150, 0, 32)
    Button.BackgroundColor3 = COLORS.PANEL
    Button.BorderSizePixel = 0
    Button.Text = name:upper()
    Button.TextColor3 = COLORS.TEXT
    Button.TextSize = 11
    Button.Font = Enum.Font.GothamBold
    Button.AutoButtonColor = false
    Button.Parent = CategoryBar

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Button

    CategoryButtons[name] = Button
    Button.MouseButton1Click:Connect(function() ShowCategory(name) end)
    return Button
end

