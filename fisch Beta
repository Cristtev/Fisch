local Categories = {}
local CategoryButtons = {}

local function createCategory(name)
	local container = Instance.new("ScrollingFrame")
	container.Name = name .. "Category"
	container.Size = UDim2.new(1, 0, 1, 0)
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.CanvasSize = UDim2.new(0, 0, 0, 0)
	container.AutomaticCanvasSize = Enum.AutomaticSize.Y
	container.ScrollBarThickness = 4
	container.Visible = false
	container.ClipsDescendants = false
	container.Parent = ContentHolder

	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 12)
	layout.Parent = container

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingBottom = UDim.new(0, 12)
	padding.Parent = container

	Categories[name] = container
	return container
end

local function showCategory(name)
	for categoryName, frame in pairs(Categories) do
		frame.Visible = (categoryName == name)
	end
	for buttonName, button in pairs(CategoryButtons) do
		if buttonName == name then
			button.BackgroundColor3 = Color3.fromRGB(0, 255, 204)
			button.TextColor3 = Color3.fromRGB(15, 15, 25)
		else
			button.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
			button.TextColor3 = Color3.fromRGB(200, 200, 220)
		end
	end
end

local function createCategoryButton(name)
	local button = Instance.new("TextButton")
	button.Name = name .. "Button"
	button.Size = UDim2.new(0, 140, 1, 0)
	button.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.Text = name:upper()
	button.TextColor3 = Color3.fromRGB(200, 200, 220)
	button.TextSize = 11
	button.AutoButtonColor = false
	button.Parent = CategoryBar

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = button

	CategoryButtons[name] = button
	button.MouseButton1Click:Connect(function() showCategory(name) end)
	return button
end

